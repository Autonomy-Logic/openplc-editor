			<Text TextId="TOK_IN64_Name" Value="Error code input 64 bytes" />
			<Text TextId="TOK_Output_Data" Value="Output data" />
			<Text TextId="TOK_OUT2_Name" Value="Output 2 bytes" />
			<Text TextId="TOK_Filter_Off" Value="Filter off" />
			<Text TextId="TOK_Filter_On" Value="Filter on" />
			<Text TextId="TOK_Overload" Value="Overload" />
