    myNewValue := myValue - 1;
ELSIF myValue &lt;&gt; 0 THEN
    myNewValue := 0;
ELSE
    myNewValue := -1;
END_IF;

FOR myValue := 0 TO 5 BY 1 DO
    myNewValue := myNewValue + myValue;
END_FOR;

CASE myNewValue OF
    0, 1: myCoil := TRUE;
    2..5: myCoil := FALSE;
ELSE
    myCoil := myContact;
END_CASE;
</STCode>
