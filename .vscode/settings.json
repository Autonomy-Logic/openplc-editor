{
  "javascript.validate.enable": false,
  "search.exclude": {
    ".git": true,
    ".eslintcache": true,
    "configs/dll": true,
    "release/{build,app/dist}": true,
    "node_modules": true,
    "npm-debug.log.*": true,
    "test/**/__snapshots__": true,
    "package-lock.json": true,
    "*.{css,sass,scss}.d.ts": true
  },
  "cSpell.words": [
    "Dropup",
    "electronmon",
    "Embla",
    "headlessui",
    "hookform",
    "IFBD",
    "immer",
    "IPLC",
    "ISFC",
    "mimetypes",
    "openplc",
    "oplc",
    "Pous",
    "serviceworker",
    "Shadcn",
    "tanstack",
    "titlebar",
    "toastify"
  ],
  "i18n-ally.localesPaths": [
    "src/locales",
    "src/utils/PLC/xml-generator/codesys/language",
    "src/utils/PLC/xml-generator/old-editor/language",
    "src/types/PLC/xml-data/codesys/pous/languages",
    "src/types/PLC/xml-data/old-editor/pous/languages",
    "src/renderer/components/_features/[workspace]/editor/monaco/configs/languages"
  ]
}
